<?xml version="1.0" encoding="UTF-8"?>
<project name="AlgTestProcess" default="jar" basedir=".">
    <description>Builds, tests, and runs AlgTestProcess.</description>

    <!-- Directories -->
    <property name="src.dir"     value="src"/>
    <property name="build.dir"   value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="dist.dir"    value="dist"/>
    <property name="dist.jar"    value="${dist.dir}/AlgTestProcess.jar"/>
    <property name="main.class"  value="algtestprocess.AlgTestProcess"/>

    <!-- Compile classpath -->
    <path id="compile.classpath">
        <pathelement location="../AlgTest_JClient/dist/AlgTestJClient.jar"/>
        <fileset dir="../libs" includes="json-simple-1.1.1.jar"/>
    </path>

    <path id="run.classpath">
        <path refid="compile.classpath"/>
        <pathelement location="${classes.dir}"/>
    </path>

    <!-- Build AlgTest_JClient first so its jar exists -->
    <target name="-pre-compile">
        <ant dir="../AlgTest_JClient" target="jar" inheritAll="false"/>
    </target>

    <target name="init">
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="-pre-compile,init">
        <javac srcdir="${src.dir}"
               destdir="${classes.dir}"
               source="1.8" target="1.8"
               encoding="UTF-8"
               includeantruntime="false"
               deprecation="false">
            <classpath refid="compile.classpath"/>
        </javac>
    </target>

    <target name="jar" depends="compile">
        <copy todir="${dist.dir}/lib">
            <fileset dir="../libs"                    includes="json-simple-1.1.1.jar"/>
            <fileset dir="../AlgTest_JClient/dist"    includes="AlgTestJClient.jar"/>
            <fileset dir="../AlgTest_JClient/dist/lib" includes="*.jar"/>
        </copy>
        <path id="dist.classpath">
            <fileset dir="${dist.dir}/lib" includes="*.jar"/>
        </path>
        <manifestclasspath property="manifest.cp" jarfile="${dist.jar}">
            <classpath refid="dist.classpath"/>
        </manifestclasspath>
        <jar destfile="${dist.jar}" basedir="${classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
                <attribute name="Class-Path" value="${manifest.cp}"/>
            </manifest>
        </jar>
    </target>

    <target name="run" depends="jar">
        <java classname="${main.class}" fork="true">
            <classpath refid="run.classpath"/>
        </java>
    </target>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

</project>
